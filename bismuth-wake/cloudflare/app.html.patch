+      .bm-chip.done{color:var(--accent,#c0f242);border-color:var(--accent,#c0f242)}
+      .bm-bar{height:3px;background:var(--border,#212124);margin-bottom:8px;overflow:hidden}
+      .bm-fill{height:100%;width:0;background:var(--accent,#c0f242);transition:width .35s ease-out}
