+      .bm-feed{height:230px;overflow:hidden;font-size:12px;line-height:1.65;border-top:1px solid var(--border,#212124);padding-top:10px}
+      .bm-l{display:flex;gap:8px;animation:bmIn .35s ease-out;white-space:pre-wrap;word-break:break-word}
+      .bm-t{color:var(--muted,#86868c);flex:none;min-width:38px;text-align:right}
