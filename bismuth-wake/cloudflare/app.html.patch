+/* ============================================================================
+   Bismuth gateway (Cloudflare) — wake the server early and wait for it patiently
+   ----------------------------------------------------------------------------
+   This page is served by Cloudflare, so it loads instantly even while the
+   Codespace is asleep. Opening it counts as "deploy": we ask the Worker to start
+   the Codespace right away — before login, while the user fills the wizard.
+   API calls that arrive while the machine is still booting are transparently
+   retried, and a live "launch console" keeps the screen moving while they wait.
+   ========================================================================== */
+const AUTO_LAUNCH_AFTER_SETUP = true;   // start Minecraft right after the first-time wizard
+const __rawFetch = window.fetch.bind(window);
+let __lastWake = 0, __waiting = 0;
+
+function __wake(){
+  if(Date.now() - __lastWake < 20000) return;
+  __lastWake = Date.now();
+  try{
+    __rawFetch('/__bismuth/wake', { method:'POST', keepalive:true })
+      .then(r => r.json())
+      .then(w => {
+        if(w && w.started) BootConsole.real('wake-up call accepted by GitHub','ok');
+        if(w && w.error === 'billing') BootConsole.real('GitHub Codespaces spending limit reached — cannot start the machine','err');
+        else if(w && w.error) BootConsole.real('could not start the machine ('+w.error+')','err');
+      })
+      .catch(()=>{});
+  }catch(e){}
+}
+
+window.fetch = async function(input, init){
+  const url = typeof input === 'string' ? input : ((input && input.url) || '');
+  if(!/^\/api\//.test(url)) return __rawFetch(input, init);
+  const t0 = Date.now();
+  let counted = false;
+  try{
+    for(;;){
+      const r = await __rawFetch(input, init);
+      if(!(r.status === 503 && r.headers.get('X-Bismuth-Asleep') === '1')) return r;
+      if(!counted){ counted = true; __waiting++; BootConsole.open('ready'); }
+      __wake();
+      if(Date.now() - t0 > 240000) return r;
+      await new Promise(res => setTimeout(res, 2500));
+    }
+  } finally {
+    if(counted) __waiting--;
+  }
+};
+
+let setupUnknown = false;          // true while the Codespace hasn't told us yet whether this account finished setup
+let setupResolved = Promise.resolve();
+function resolveSetupInBackground(){
+  setupResolved = (async()=>{
+    for(let i = 0; i < 120; i++){
+      await new Promise(r => setTimeout(r, 2500));
+      try{
+        const r = await __rawFetch('/api/me');
+        const d = await r.json();
+        if(typeof d.setupComplete === 'boolean'){
+          setupUnknown = false;
+          if(d.setupComplete){
+            setupComplete = true;
+            const w = document.getElementById('wizard');
+            if(!w.classList.contains('hidden')){
+              w.classList.add('hidden');
+              BootConsole.close();
+              appendLog('existing world found — using your saved settings','info');
+              initDashboard();
+            }
+          }
+          return;
+        }
+      }catch{}
+    }
+  })();
+}
