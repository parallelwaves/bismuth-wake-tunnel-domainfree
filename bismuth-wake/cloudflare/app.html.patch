+
+const BootConsole = (function(){
+  const PHASES = [
+    { id:'cloud',  label:'cloud machine',  from:0,  to:42, tau:45 },
+    { id:'engine', label:'bismuth engine', from:42, to:58, tau:8  },
+    { id:'world',  label:'minecraft',      from:58, to:97, tau:70 },
+  ];
+  const S = { open:false };
+
+  function h(tag, cls, text){
