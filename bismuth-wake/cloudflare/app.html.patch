+
+  function line(text, kind){
+    if(!S.open || !S.els) return;
+    const sec = Math.round((Date.now() - S.t0) / 1000);
+    const glyph = { ok:'✓', err:'✗', mc:'›', flavor:'~', tip:'~', info:'●', warn:'!' }[kind] || '●';
+    const row = h('div','bm-l bm-' + kind);
+    row.appendChild(h('span','bm-t','+' + sec + 's'));
+    row.appendChild(h('span','bm-g',glyph));
+    row.appendChild(h('span','bm-m',String(text)));
+    const f = S.els.feed;
+    f.appendChild(row);
+    while(f.children.length > 40) f.removeChild(f.firstChild);
+    f.scrollTop = f.scrollHeight;
+    S.lastAt = Date.now();
+    S.nextGap = 1000 + Math.random() * 1500;
+  }
+
+  function flavor(){
+    S.n++;
+    const isTip = S.n % 5 === 0;
+    const key = isTip ? 'tip' : PHASES[S.phase].id;
+    const pool = isTip ? BOOT_TIPS : BOOT_FLAVOR[key];
+    const i = (S.cursor[key] = (S.cursor[key] == null ? Math.floor(Math.random() * pool.length) : S.cursor[key] + 1)) % pool.length;
+    line(pool[i], isTip ? 'tip' : 'flavor');
+  }
+
+  function setPhase(i){
+    if(!S.open || i <= S.phase) return;
+    S.phase = i;
+    S.pStart = Date.now();
+    S.pct = Math.max(S.pct, PHASES[i].from);
+  }
+
+  function render(){
+    const now = Date.now();
+    const p = PHASES[S.phase];
+    if(!S.done && !S.failed){
+      const target = p.from + (p.to - p.from) * (1 - Math.exp(-(now - S.pStart) / 1000 / p.tau));
+      S.pct = Math.max(S.pct, Math.min(target, p.to - 0.5));
+    }
+    S.els.fill.style.width = S.pct.toFixed(1) + '%';
+    S.els.clock.textContent = fmt((now - S.t0) / 1000);
+    S.els.chipEls.forEach((c, i) => {
+      c.className = 'bm-chip' + (S.done || i < S.phase ? ' done' : i === S.phase && !S.failed ? ' active' : '');
+    });
+  }
+
+  function tick(){
+    if(!S.open) return;
+    render();
+    if(S.done || S.failed) return;
+    const now = Date.now();
+    if(now - S.lastAt > S.nextGap) flavor();
+    if(!S.slowShown && now - S.t0 > 360000){
+      S.slowShown = true;
+      line('taking longer than usual — see "Getting the logs" in the README','warn');
+    }
+  }
+
+  function describe(s){
+    const st = s.state;
+    if(st === 'Shutdown') return line('cloud machine is asleep — sending the wake-up call','info');
+    if(st === 'ShuttingDown') return line('machine is still shutting down from earlier — waiting for it to finish','info');
+    if(st === 'NotFound') { S.failed = true; return line('Codespace not found — check CODESPACE_NAME / CODESPACE_REPO on the Worker','err'); }
+    if(st === 'AuthError') { S.failed = true; return line('GitHub rejected the token — check GH_TOKEN on the Worker','err'); }
+    if(['Failed','Deleted','Archived','Moved'].includes(st)) { S.failed = true; return line('Codespace is ' + String(st).toLowerCase() + ' — open GitHub → Codespaces to check it','err'); }
+    if(st === 'Available' && !s.ready){
+      if(s.reason === 'app_starting') line('waiting for the Cloudflare tunnel to connect…','info');
+      line('cloud machine is online','ok');
+      return line('starting the Bismuth engine…','info');
+    }
+    return line('cloud machine is booting…','info');
+  }
+
+  async function poll(){
+    if(!S.open || S.phase >= 2 || S.polling) return;
+    S.polling = true;
+    try{
+      const r = await __rawFetch('/__bismuth/status', { cache:'no-store' });
+      const s = await r.json();
+      if(!S.open) return;
+      const key = s.state + '|' + (s.ready ? 'ready' : (s.reason || ''));
+      if(key !== S.machine){ S.machine = key; if(!s.ready) describe(s); }
+      if(s.state === 'Available' && !s.ready) setPhase(1);
+      if(s.ready){
+        line('cloud machine online','ok');
+        line('Bismuth engine is answering','ok');
+        setPhase(2);
+        if(S.goal === 'ready') finish('ready');
+      }
+    }catch(e){ /* try again on the next poll */ }
+    finally{ S.polling = false; }
+  }
+
+  function finish(msg){
+    if(S.done) return;
+    S.done = true;
+    S.pct = 100;
+    line(msg, 'ok');
+    render();
+    S.closeTimer = setTimeout(close, 1400);
+  }
+
+  function open(goal){
+    if(S.open){ if(goal === 'online') S.goal = 'online'; return; }
+    Object.assign(S, { open:true, goal, phase:0, t0:Date.now(), pStart:Date.now(), pct:0, lastAt:Date.now(), nextGap:900,
+                       n:0, cursor:{}, machine:'', done:false, failed:false, slowShown:false, polling:false,
+                       mcCount:0, mcWindow:0, firstStatus:true, startedMC:false, closeTimer:null });
+    build();
+    line('launch sequence started','info');
+    render();
+    S.timer = setInterval(tick, 250);
+    S.pollTimer = setInterval(poll, 2500);
+    poll();
+  }
+
+  function close(){
+    if(!S.open) return;
+    S.open = false;
+    clearInterval(S.timer); clearInterval(S.pollTimer); clearTimeout(S.closeTimer);
+    if(S.els && S.els.root) S.els.root.remove();
+    S.els = null;
+  }
+
+  // Minecraft's own console lines (called from appendLog)
+  function mc(text, type){
+    if(!S.open || S.done) return;
+    text = String(text || '').trim();
+    if(!text) return;
+    const now = Date.now();
+    if(now - S.mcWindow > 1000){ S.mcWindow = now; S.mcCount = 0; }
+    const isErr = type === 'error';
+    if(++S.mcCount <= 8 || isErr){
+      line(text, isErr ? 'err' : type === 'warn' ? 'warn' : 'mc');
+    }
+    if(S.goal === 'online' && S.phase < 2) setPhase(2);
+    if(isErr) S.failed = true;
+    if(S.goal === 'online' && /Done \(\d/.test(text)) finish('server online — enjoy!');
+  }
+
+  // Status snapshots from the WebSocket (called from applyStatus)
+  function status(st){
+    if(!S.open || S.done || S.goal !== 'online') return;
+    if(S.firstStatus){
+      S.firstStatus = false;
+      if(st.running && (st.uptime || 0) > 30){ finish('your server is already online'); return; }
+    }
+    if(st.running && !S.startedMC){
+      S.startedMC = true;
+      line('Minecraft process started','ok');
+      setPhase(2);
+    }
+  }
+
+  return { open, close, real:(t,k)=>line(t, k || 'info'), mc, status, isOpen:()=>S.open, _state:S };
+})();
