+      .bm-card{width:100%;max-width:580px;background:var(--surface,#0d0d0f);color:var(--text,#e4e4e6);border:1px solid var(--border,#212124);padding:20px 20px 16px}
+      .bm-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
+      .bm-title{font-weight:600;font-size:15px}
+      .bm-hide{background:none;border:1px solid var(--border,#212124);color:var(--muted,#86868c);font:inherit;font-size:11px;padding:3px 9px;cursor:pointer}
+      .bm-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
+      .bm-chip{font-size:11px;padding:3px 9px;border:1px solid var(--border,#212124);color:var(--muted,#86868c)}
