+      .bm-cur{display:inline-block;width:7px;height:13px;background:var(--accent,#c0f242);vertical-align:-2px;animation:bmBlink 1s steps(1) infinite}
+      @keyframes bmIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
+      @keyframes bmPulse{50%{opacity:.45}}
+      @keyframes bmBlink{50%{opacity:0}}`;
+    document.head.appendChild(s);
+  }
+
+  function build(){
+    addCss();
+    const root = h('div','bm-boot'); root.id = 'bm-boot';
+    const card = h('div','bm-card');
+    const head = h('div','bm-head');
+    head.appendChild(h('span','bm-title','Launching your server'));
+    const hide = h('button','bm-hide','hide'); hide.onclick = () => close();
+    head.appendChild(hide);
+    const chips = h('div','bm-chips');
+    const chipEls = PHASES.map(p => { const c = h('span','bm-chip',p.label); chips.appendChild(c); return c; });
+    const bar = h('div','bm-bar'); const fill = h('div','bm-fill'); bar.appendChild(fill);
+    const meta = h('div','bm-meta');
